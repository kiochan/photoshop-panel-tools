<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PanelTools.Demo" />
    <EmbeddedResource Include="..\..\shared\windows-native\strings.en.json" LogicalName="PanelTools.Strings.en.json" WithCulture="false" />
    <Compile Include="..\..\shared\windows-native\UiText.cs" Link="UiText.cs" />
    <Compile Include="..\PanelRecall\Native.cs" Link="Recall\Native.cs" />
    <Compile Include="..\PanelRecall\Storage.cs" Link="Recall\Storage.cs" />
    <Compile Include="..\PanelRecall\RecallSession.cs" Link="Recall\RecallSession.cs" />
    <Compile Include="..\..\shared\windows-native\CanvasClickHook.cs" Link="Recall\CanvasClickHook.cs" />
    <Compile Include="..\..\shared\windows-native\ProcessIdentity.cs" Link="Recall\ProcessIdentity.cs" />
  </ItemGroup>
</Project>
